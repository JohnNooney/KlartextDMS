# Local App Check debug tokens (issue #21) — registered in the Firebase
# console, gitignored via .env; CI carries the same names as secrets for
# e2e/preview builds. The Host reads them via apps/host's
# write-local-config.mjs; the Guest via vite.config.ts's envDir/envPrefix.
KLARTEXT_HOST_DEBUG_TOKEN=
KLARTEXT_GUEST_DEBUG_TOKEN=

# Guest AI provider (issue #30): serve Extractions from the seeded fixtures
# instead of calling Gemini — deterministic, offline, free. Used by e2e
# builds; unset/anything-else keeps the real model (dev keeps it real so a
# genuine round-trip stays one flag away).
VITE_FAKE_AI_PROVIDER=
