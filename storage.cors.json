[
  {
    "origin": ["*"],
    "method": ["GET", "HEAD", "POST", "PUT", "DELETE", "OPTIONS"],
    "responseHeader": [
      "Content-Type",
      "Content-Length",
      "ETag",
      "X-Goog-Upload-URL",
      "X-Goog-Upload-Status",
      "X-Goog-Upload-Chunk-Granularity",
      "X-Goog-Upload-Size-Received",
      "X-Goog-Upload-Control-URL"
    ],
    "maxAgeSeconds": 3600
  }
]
